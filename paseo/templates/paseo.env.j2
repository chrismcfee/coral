{{ ansible_managed | comment }}
# Daemon environment for paseo. Loaded by BOTH init systems — systemd via EnvironmentFile=, OpenRC
# by sourcing it in the service script — so the agent CLIs Paseo launches (and any MCP server)
# inherit these. They resolve the {env:VAR} placeholders in your sanitized opencode.json[c], and
# carry ANTHROPIC_API_KEY for Claude Code and the KIMI_MODEL_* family for Kimi Code. Managed by
# Ansible from paseo_opencode_secrets + paseo_claude_secrets + paseo_kimicode_secrets (Vault),
# unioned in tasks/service.yml; mode 0640 root:paseo.
# Do NOT put PATH here — PATH is owned by the unit (see paseo_service_path). Do NOT put the
# daemon's own settings here either (PASEO_PASSWORD, PASEO_LISTEN, PORT, …): the daemon acts on
# them instead of passing them to the agent.
#
# Single-quoted so the value is taken literally by both systemd and `.`-sourcing (no shell
# expansion). Single quotes inside a value are escaped '\''; avoid newlines in secret values.
{% for k, v in (_paseo_agent_secrets | dictsort) %}
{{ k }}='{{ v | string | replace("'", "'\\''") }}'
{% endfor %}
