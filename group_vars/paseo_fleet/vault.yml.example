---
# Copy to vault.yml in this directory, fill in the real values, then encrypt:
#   ansible-vault encrypt group_vars/paseo_fleet/vault.yml
#
# The keys under paseo_opencode_secrets MUST match the {env:VAR} placeholders in ../../opencode.jsonc.
# You can generate this whole block from your OpenCode .env instead of typing it:
#   ./opencode-secrets-from-env.sh ~/.config/opencode/.env
# (prints `paseo_opencode_secrets:` with the values — pipe to vault.yml and encrypt).

# The Paseo daemon password. If your opencode.jsonc calls Paseo back over MCP with
# Authorization: Bearer {env:PASEO_TOKEN}, set PASEO_TOKEN below to this same value.
vault_paseo_daemon_password: "change-me"

paseo_opencode_secrets:
  CONTEXT7_API_KEY: ""
  EXA_API_KEY: ""
  Z_AI_ZREAD_TOKEN: ""
  Z_AI_WSP_TOKEN: ""
  Z_AI_WR_TOKEN: ""
  Z_AI_API_KEY: ""
  PASEO_TOKEN: ""          # the bearer the local OpenCode uses to call Paseo (== daemon password)
  OPENSEARCH_WEB_URL: "https://searx.perennialte.ch/"   # non-secret: enables OpenCode optional web search

# Optional: only if your primary provider (zai-coding-plan) authenticates via `opencode auth login`
# rather than an {env:VAR} apiKey in opencode.jsonc. Paste that auth.json as a dict; it's deployed
# 0600 to the daemon user's ~/.local/share/opencode/auth.json.
# paseo_opencode_auth:
#   zai-coding-plan:
#     type: "api"
#     key: "..."

# NOTE on key names in ANY of these dicts: don't use the daemon's own setting names
# (PASEO_PASSWORD, PASEO_LISTEN, PASEO_HOSTNAMES, PORT, …). The daemon reads its settings from the
# same environment, so it would act on them instead of handing them to the agent. PASEO_TOKEN above
# is fine — it means nothing to the daemon.

# Optional: Claude Code credentials, only when paseo_install_claude is true. Merged with
# paseo_opencode_secrets into the SAME /etc/paseo/paseo.env, so key names must not collide.
# paseo_claude_secrets:
#   ANTHROPIC_API_KEY: ""
#
# For a gateway instead of a direct Anthropic key, use these two rather than ANTHROPIC_API_KEY.
# The endpoint must speak the Anthropic Messages API (POST /v1/messages) — an OpenAI-compatible
# endpoint (Z.AI's, TensorZero's) needs a translating proxy in front of it.
# paseo_claude_secrets:
#   ANTHROPIC_BASE_URL: "http://127.0.0.1:4000"
#   ANTHROPIC_AUTH_TOKEN: ""

# Optional: Kimi Code credentials, only when paseo_install_kimicode is true. Same env file again,
# so key names must not collide with the dicts above.
#
# Kimi Code does NOT read a bare KIMI_API_KEY / MOONSHOT_API_KEY from the environment. The
# env-only path is the KIMI_MODEL_* family, and KIMI_MODEL_NAME is what switches it on:
# paseo_kimicode_secrets:
#   KIMI_MODEL_NAME: "kimi-for-coding"                      # the model id your endpoint serves
#   KIMI_MODEL_API_KEY: ""
#   KIMI_MODEL_BASE_URL: "https://api.kimi.com/coding/v1"   # omit for https://api.moonshot.ai/v1
#
# Or keep the key under a name of your choosing and reference it from a sanitized config.toml
# (`api_key_env = "MY_KIMI_KEY"`), seeded with paseo_kimicode_config_src:
# paseo_kimicode_secrets:
#   MY_KIMI_KEY: ""
#
# A Kimi Code subscription (OAuth) needs nothing here: log the daemon user in once per host with
#   sudo -u paseo env HOME=/var/lib/paseo /var/lib/paseo/.kimi-code/bin/kimi login
